        ],
        "operationId": "list_matches",
        "responses": {
          "200": {
            "description": "TODO"
          }
        }
      }
    },
    "/api/match/{uuid}": {
      "get": {
        "tags": [
          "r#match"
        ],
        "operationId": "get_match",
        "responses": {
          "200": {
            "description": "TODO"
          }
        }
      },
      "put": {
        "tags": [
          "r#match"
        ],
        "operationId": "put_match",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnyMatchWrapper"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "TODO"
          }
